<mujoco model="Visincept banner barrier">
  <asset>
    <texture name="visincept_print" type="2d" file="visincept_banner.png"/>
    <material name="fabric" texture="visincept_print" rgba="1 1 1 1"
              specular="0.03" shininess="0.08"/>
    <material name="powder_coat" rgba="0.055 0.058 0.064 1"
              specular="0.32" shininess="0.24"/>
    <!-- The print has an outward-facing UV layout on each side. -->
    <mesh name="banner"
          vertex="-0.64 -0.0015 -0.35  0.64 -0.0015 -0.35  0.64 -0.0015 0.35  -0.64 -0.0015 0.35
                  -0.64  0.0015 -0.35  0.64  0.0015 -0.35  0.64  0.0015 0.35  -0.64  0.0015 0.35"
          texcoord="0 1  1 1  1 0  0 0   1 1  0 1  0 0  1 0"
          face="0 1 2  0 2 3  4 6 5  4 7 6
                0 4 5  0 5 1  3 2 6  3 6 7
                0 3 7  0 7 4  1 5 6  1 6 2"/>
  </asset>
  <worldbody>
    <!-- Lengths in metres. Origin is on the ground midway between the posts. -->
    <body name="banner_barrier">
      <frame pos="-0.74 0 0">
        <body name="left_stanchion">
          <geom name="left_base" type="cylinder" pos="0 0 0.015" size="0.16 0.015"
                material="powder_coat" contype="1" conaffinity="2"/>
          <geom name="left_post" type="cylinder" pos="0 0 0.415" size="0.0325 0.385"
                material="powder_coat" contype="1" conaffinity="2"/>
          <geom name="left_cap" type="cylinder" pos="0 0 0.848" size="0.045 0.052"
                material="powder_coat" contype="1" conaffinity="2"/>
        </body>
      </frame>
      <frame pos="0.74 0 0">
        <body name="right_stanchion">
          <geom name="right_base" type="cylinder" pos="0 0 0.015" size="0.16 0.015"
                material="powder_coat" contype="1" conaffinity="2"/>
          <geom name="right_post" type="cylinder" pos="0 0 0.415" size="0.0325 0.385"
                material="powder_coat" contype="1" conaffinity="2"/>
          <geom name="right_cap" type="cylinder" pos="0 0 0.848" size="0.045 0.052"
                material="powder_coat" contype="1" conaffinity="2"/>
        </body>
      </frame>
      <body name="banner_panel">
        <geom name="upper_rail" type="cylinder" fromto="-0.74 0 0.86  0.74 0 0.86" size="0.03"
              material="powder_coat" contype="1" conaffinity="2"/>
        <geom name="lower_rail" type="cylinder" fromto="-0.74 0 0.12  0.74 0 0.12" size="0.01"
              material="powder_coat" contype="1" conaffinity="2"/>
        <geom name="banner_print" type="mesh" mesh="banner" pos="0 0 0.48"
              material="fabric" contype="0" conaffinity="0"/>
        <geom name="banner_collision" type="box" pos="0 0 0.48" size="0.64 0.0015 0.35"
              rgba="0.3 0.7 0.9 0.2" group="3" contype="1" conaffinity="2"/>
      </body>
    </body>
  </worldbody>
</mujoco>
